{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/rodolvbg/django-chat-ui/blob/HEAD/docs/protocol.schema.json",
    "title": "django-chat-ui's extensions to Matrix, profile 1.0",
    "description": "The contents django-chat-ui adds to the Matrix Client-Server API (docs/protocol.md), namespaced under io.github.rodolvbg.chat. Open by design: unknown fields are allowed everywhere, and other clients ignore what they don't know.",
    "$defs": {
        "namespaced": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
        },
        "ext": {
            "type": "object",
            "description": "A site's data, keyed by its namespace (com.acme).",
            "propertyNames": { "$ref": "#/$defs/namespaced" }
        },
        "button": {
            "type": "object",
            "required": ["id"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "style": { "enum": ["primary", "secondary", "danger"] }
            }
        },
        "conversation": {
            "title": "io.github.rodolvbg.chat.conversation (state event)",
            "type": "object",
            "required": ["channel", "state"],
            "properties": {
                "channel": { "type": "string" },
                "state": { "type": "string" },
                "ext": { "$ref": "#/$defs/ext" }
            }
        },
        "participant": {
            "title": "io.github.rodolvbg.chat.participant (block of m.room.member)",
            "type": "object",
            "properties": {
                "kind": { "type": "string" },
                "handle": { "type": "string" },
                "avatar": { "type": "string", "format": "uri" },
                "ext": { "$ref": "#/$defs/ext" }
            }
        },
        "capabilities": {
            "title": "io.github.rodolvbg.chat.capabilities (state event)",
            "type": "object",
            "properties": {
                "attachments": {
                    "oneOf": [
                        { "const": false },
                        {
                            "type": "object",
                            "properties": {
                                "types": {
                                    "type": "array",
                                    "items": {
                                        "enum": [
                                            "image",
                                            "video",
                                            "audio",
                                            "file"
                                        ]
                                    }
                                },
                                "maxSize": { "type": "integer", "minimum": 0 }
                            }
                        }
                    ]
                },
                "receipts": { "type": "boolean" },
                "typing": { "type": "boolean" },
                "buttons": { "type": "boolean" },
                "replies": { "type": "boolean" },
                "reactions": {
                    "oneOf": [
                        { "type": "boolean" },
                        {
                            "type": "object",
                            "properties": {
                                "emojis": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                }
                            }
                        }
                    ]
                },
                "edit": { "type": "boolean" },
                "delete": { "type": "boolean" },
                "history": { "type": "boolean" },
                "composer": {
                    "type": "object",
                    "properties": {
                        "mode": {
                            "type": "string",
                            "description": "free, templates, actions, closed, or a namespaced one."
                        },
                        "maxLength": { "type": "integer", "minimum": 1 },
                        "placeholder": { "type": "string" },
                        "reason": { "type": "string" },
                        "templates": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["id"],
                                "properties": {
                                    "id": { "type": "string" },
                                    "name": { "type": "string" },
                                    "preview": { "type": "string" },
                                    "params": {
                                        "type": "array",
                                        "items": { "type": "string" }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "additionalProperties": true
        },
        "buttons": {
            "title": "io.github.rodolvbg.chat.buttons (block of a message)",
            "type": "object",
            "required": ["buttons"],
            "properties": {
                "buttons": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/button" }
                },
                "body": {
                    "type": "string",
                    "description": "The text before the buttons."
                },
                "formatted_body": { "type": "string" },
                "persist": { "type": "boolean" }
            }
        },
        "action": {
            "title": "io.github.rodolvbg.chat.action (block of an answer)",
            "type": "object",
            "required": ["event_id", "button"],
            "properties": {
                "event_id": { "type": "string" },
                "button": { "type": "string" }
            }
        },
        "link": {
            "title": "io.github.rodolvbg.chat.link (block of a message)",
            "type": "object",
            "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "image": { "type": "string" }
            }
        },
        "system": {
            "title": "io.github.rodolvbg.chat.system (block of a notice)",
            "type": "object",
            "properties": { "code": { "type": "string" } }
        },
        "card": {
            "title": "msgtype io.github.rodolvbg.chat.card",
            "type": "object",
            "required": ["msgtype", "body", "io.github.rodolvbg.chat.card"],
            "properties": {
                "msgtype": { "const": "io.github.rodolvbg.chat.card" },
                "body": { "type": "string" },
                "io.github.rodolvbg.chat.card": {
                    "type": "object",
                    "properties": {
                        "title": { "type": "string" },
                        "text": { "type": "string" },
                        "image": { "type": "string" },
                        "url": { "type": "string" }
                    }
                },
                "io.github.rodolvbg.chat.buttons": { "$ref": "#/$defs/buttons" }
            }
        },
        "template": {
            "title": "msgtype io.github.rodolvbg.chat.template",
            "type": "object",
            "required": ["msgtype", "body", "io.github.rodolvbg.chat.template"],
            "properties": {
                "msgtype": { "const": "io.github.rodolvbg.chat.template" },
                "body": { "type": "string" },
                "io.github.rodolvbg.chat.template": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                        "id": { "type": "string" },
                        "params": {
                            "type": "object",
                            "additionalProperties": { "type": "string" }
                        }
                    }
                }
            }
        },
        "contact": {
            "title": "msgtype io.github.rodolvbg.chat.contact",
            "type": "object",
            "required": ["msgtype", "body", "io.github.rodolvbg.chat.contact"],
            "properties": {
                "msgtype": { "const": "io.github.rodolvbg.chat.contact" },
                "body": { "type": "string" },
                "io.github.rodolvbg.chat.contact": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                        "name": { "type": "string" },
                        "phones": {
                            "type": "array",
                            "items": { "type": "string" }
                        },
                        "emails": {
                            "type": "array",
                            "items": { "type": "string" }
                        }
                    }
                }
            }
        },
        "stream": {
            "title": "io.github.rodolvbg.chat.stream (ephemeral event; and, with id only, block of the message written)",
            "type": "object",
            "required": ["id"],
            "properties": {
                "id": { "type": "string" },
                "sender": { "type": "string" },
                "body": { "type": "string" },
                "markdown": { "type": "boolean" },
                "done": { "type": "boolean" }
            }
        },
        "status": {
            "title": "io.github.rodolvbg.chat.status (ephemeral event; and in a message's unsigned)",
            "type": "object",
            "required": ["status"],
            "properties": {
                "event_id": { "type": "string" },
                "status": { "type": "string" },
                "error": {
                    "type": "object",
                    "properties": {
                        "errcode": { "type": "string" },
                        "error": { "type": "string" }
                    }
                }
            }
        }
    }
}
